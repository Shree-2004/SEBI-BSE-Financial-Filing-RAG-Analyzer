QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# CORS — comma-separated exact origins allowed to call this API.
# Leave unset for local dev (defaults to localhost:5173/3000).
# Set to your deployed Vercel URL(s) in production, e.g.:
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=

# Optional — error tracking. Leave unset to disable (no-op).
SENTRY_DSN=
ENVIRONMENT=production

# Set to "false" to skip loading the CrossEncoder reranker at startup.
# Saves a meaningful chunk of RAM (a second transformer model in memory) at
# the cost of retrieval precision — useful if you're stuck on a <1GB host
# tier. Leave unset ("true") if your host has ~1GB+ RAM.
USE_RERANKER=true

# Which index to serve. The defaults are the Docling-parsed index (the
# tracked data/processed/bm25_index.pkl + the cloud "filing_chunks" collection).
QDRANT_COLLECTION=filing_chunks
BM25_INDEX_PATH=data/processed/bm25_index.pkl

# Local on-disk Qdrant (no cloud account needed). Overrides QDRANT_URL when set.
# QDRANT_PATH=data/qdrant_local

# Groq model override. Default: openai/gpt-oss-120b (llama-3.3-70b-versatile
# was retired by Groq in Oct 2026).
# GROQ_MODEL=openai/gpt-oss-120b
