QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# CORS — comma-separated exact origins allowed to call this API.
# Leave unset for local dev (defaults to localhost:5173/3000).
# Set to your deployed Vercel URL(s) in production, e.g.:
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=

# Optional — error tracking. Leave unset to disable (no-op).
SENTRY_DSN=
ENVIRONMENT=production

# Set to "false" to skip loading the CrossEncoder reranker at startup.
# Saves a meaningful chunk of RAM (a second transformer model in memory) at
# the cost of retrieval precision — useful if you're stuck on a <1GB host
# tier. Leave unset ("true") if your host has ~1GB+ RAM.
USE_RERANKER=true
